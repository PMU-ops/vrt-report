{
  "id": "backstop_default",
  "viewports": [
    {
      "label": "desktop",
      "width": 1920,
      "height": 1080
    }
  ],
  "onBeforeScript": "puppet/onBefore.js",
  "onReadyScript": "puppet/onReady.js",
  "cookiePath": "backstop_data/engine_scripts/cookies.json",
  "scenarios": [
    {
      "label": "Home",
      "url": "https://www.awf.org/",
      "referenceUrl": "https://autopilot-awfd8-sandbox.pantheonsite.io/",
      "misMatchThreshold": 5,
      "requireSameDimensions": false
    },
    {
      "label": "Wildlife Conservation – All",
      "url": "https://www.awf.org/wildlife-conservation/all",
      "referenceUrl": "https://autopilot-awfd8-sandbox.pantheonsite.io/wildlife-conservation/all",
      "misMatchThreshold": 5,
      "requireSameDimensions": false
    },
    {
      "label": "Wildlife Conservation – Pangolin",
      "url": "https://www.awf.org/wildlife-conservation/pangolin",
      "referenceUrl": "https://autopilot-awfd8-sandbox.pantheonsite.io/wildlife-conservation/pangolin",
      "misMatchThreshold": 5,
      "requireSameDimensions": false
    },
    {
      "label": "News",
      "url": "https://www.awf.org/news",
      "referenceUrl": "https://autopilot-awfd8-sandbox.pantheonsite.io/news",
      "misMatchThreshold": 5,
      "requireSameDimensions": false
    },
    {
      "label": "Safaris",
      "url": "https://www.awf.org/safaris",
      "referenceUrl": "https://autopilot-awfd8-sandbox.pantheonsite.io/safaris",
      "misMatchThreshold": 5,
      "requireSameDimensions": false
    },
    {
      "label": "News – Mystery Giraffes",
      "url": "https://www.awf.org/news/mystery-giraffes-africa",
      "referenceUrl": "https://autopilot-awfd8-sandbox.pantheonsite.io/news/mystery-giraffes-africa",
      "misMatchThreshold": 5,
      "requireSameDimensions": false
    }
  ],
  "paths": {
    "bitmaps_reference": "backstop_data/bitmaps_reference",
    "bitmaps_test": "backstop_data/bitmaps_test",
    "engine_scripts": "backstop_data/engine_scripts",
    "html_report": "backstop_data/html_report",
    "ci_report": "backstop_data/ci_report"
  },
  "report": [
    "browser"
  ],
  "engine": "puppeteer",
  "engineOptions": {
    "args": [
      "--no-sandbox"
    ],
    "timeout": 0,
    "waitTimeout": 180000
